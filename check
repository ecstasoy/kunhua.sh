#!/usr/bin/env bash
# The one gate. CI runs this same script.
#
# Takes a slice, because the two halves deploy independently: `check web`,
# `check api`, or no argument for both. A failing Go test must not block
# publishing a post — that isolation is the whole reason the pipelines are
# path-filtered — but locally you want the lot, so the default is everything.
set -euo pipefail
cd "$(dirname "$0")"

check_api() {
  echo "→ api-release.sh"
  node --test test/api-release.test.mjs

  echo "→ go vet"
  (cd api && go vet ./...)

  # gofmt reports rather than fails, so its output has to be turned into an
  # exit code by hand. An empty list is the passing case.
  echo "→ gofmt"
  unformatted=$(cd api && gofmt -l .)
  if [ -n "$unformatted" ]; then
    echo "not gofmt'd:" >&2
    echo "$unformatted" >&2
    exit 1
  fi

  # -race because the service runs jobs alongside an HTTP server, and -count=2
  # because a test that passes only on a fast machine is a test that fails in
  # CI: a sleep long enough here was not long enough there.
  echo "→ go test"
  (cd api && go test -race -count=2 ./...)
}

check_unit() {
  # The unit's confinement is now a list of directives rather than something a
  # container implies, and a directive can be present, loaded, and inert — a
  # mid-list ~@privileged parsed as a syscall name did exactly that, and only
  # this number caught it. The floor is what makes a missing constraint visible.
  #
  # Deliberately its own slice, and a hard failure when systemd-analyze is
  # absent rather than a skip. A check that quietly passes on the developer's
  # machine is the failure this project keeps meeting; on macOS you simply do
  # not run this slice, and CI always does.
  local unit=deploy/kunhua-api.service
  local max=1.4

  if ! command -v systemd-analyze >/dev/null; then
    echo "systemd-analyze not found: check unit needs Linux with systemd" >&2
    exit 1
  fi

  echo "→ systemd-analyze security"
  local out score
  out=$(systemd-analyze security --offline=true --no-pager "$unit")
  score=$(printf '%s\n' "$out" | sed -n 's/.*Overall exposure level for [^:]*: \([0-9.]*\).*/\1/p')

  if [ -z "$score" ]; then
    echo "could not read an exposure score from:" >&2
    printf '%s\n' "$out" >&2
    exit 1
  fi

  echo "   exposure $score (max $max)"
  # The weights are systemd's, so a version bump can move the number without
  # anything here changing. If that happens, re-baseline once and say so in the
  # commit — do not widen it to make a red gate green.
  if ! awk -v s="$score" -v m="$max" 'BEGIN { exit !(s <= m) }'; then
    echo "exposure $score is worse than the floor of $max" >&2
    printf '%s\n' "$out" | grep '✗' >&2
    exit 1
  fi
}

check_web() {
  # Pure logic, no browser: node runs the TypeScript directly. The rule for
  # when a track stops being current is separable from its rendering precisely
  # so it can be tested at all.
  echo "→ view logic"
  node --test test/nowPlaying.test.ts

  echo "→ release.sh"
  node --test test/release.test.mjs

  # These drive builds of their own with a fixture post in content/, so they run
  # before the real build — otherwise the last build they leave behind is the one
  # that gets deployed, fixture and all.
  echo "→ front-matter"
  node --test test/frontmatter.test.mjs

  echo "→ build"
  (cd web && npm run build)

  echo "→ output"
  node --test test/output.test.mjs

  echo "→ links"
  # linkinator serves the directory over HTTP, so every link becomes a
  # localhost URL. Skipping /^https?:\/\// therefore skips everything — it
  # reported "scanned 0 links" and looked like it was passing. Exclude only
  # links that are not local.
  (cd web && npx linkinator out --recurse --silent --skip '^https?://(?!localhost|127\.0\.0\.1)')
}

# `unit` is not in `all`: it needs systemd, and the machine this is written on
# does not have it. CI runs it explicitly.
case "${1:-all}" in
  api)  check_api ;;
  web)  check_web ;;
  unit) check_unit ;;
  all)  check_api; check_web ;;
  *)    echo "usage: check [api|web|unit]" >&2; exit 2 ;;
esac
